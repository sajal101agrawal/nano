FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat python3 make g++

FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci

FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY worker ./worker
COPY tsconfig.json ./
RUN npx tsx worker/src/index.ts --version 2>/dev/null || true
RUN mkdir -p worker/dist && npx tsc --project tsconfig.worker.json || npx tsx worker/src/index.ts

FROM base AS runner
WORKDIR /app
ENV NODE_ENV production
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 worker
COPY --from=deps /app/node_modules ./node_modules
COPY --from=builder /app/worker ./worker
USER worker
CMD ["node", "-r", "tsx/cjs", "worker/src/index.ts"]
