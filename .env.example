# =============================================
# Nano — Staff Augmentation Talent Platform
# =============================================
# Copy this file to .env for local dev.
# On Railway: set all variables in the service's
# Variables panel. DATABASE_URL and REDIS_URL are
# injected automatically by Railway's plugins.
# =============================================

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# On Railway set to your public domain e.g. https://nano.up.railway.app
APP_SECRET=your-super-secret-key-change-this-in-production-minimum-32-chars

# Session
SESSION_SECRET=your-session-secret-change-this-minimum-32-characters-long

# Database — injected automatically on Railway via Postgres plugin
DATABASE_URL=postgresql://nano_user:nano_pass@localhost:5432/nano_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis — injected automatically on Railway via Redis plugin
REDIS_URL=redis://localhost:6379

# S3 / MinIO
# Local dev: use the docker-compose MinIO defaults below.
# Railway: set S3_ENDPOINT to your internal MinIO service URL
#   e.g. https://minio.railway.internal:9000
#   and set MINIO_ROOT_USER / MINIO_ROOT_PASSWORD as the credentials.
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=nano-cvs
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000

# MinIO admin credentials (used by Dockerfile.minio)
# Must match S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY above.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Embeddings (OpenAI or compatible)
OPENAI_API_KEY=sk-your-openai-key
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIMENSIONS=1536

# Email — Resend (Transactional)
RESEND_API_KEY=re_your-resend-key
EMAIL_FROM_TRANSACTIONAL=noreply@yourdomain.com
EMAIL_FROM_OUTREACH=talent@mail.yourdomain.com
EMAIL_FROM_NAME="Sajal Tech Talent"
EMAIL_REPLY_TO=contact@sajaltech.com

# SMS — Twilio (OTP)
TWILIO_ACCOUNT_SID=ACyour-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# External Sourcing — Apollo.io
APOLLO_API_KEY=your-apollo-api-key

# Admin initial credentials (used by seed script on first boot)
ADMIN_EMAIL=admin@sajaltech.com
ADMIN_PASSWORD=ChangeMe!2024#Nano
ADMIN_NAME=Admin

# Rate limiting
OTP_RATE_LIMIT_PER_HOUR=5
OTP_EXPIRY_MINUTES=10

# File upload limits
MAX_CV_SIZE_MB=10

# Availability token expiry
AVAILABILITY_TOKEN_EXPIRY_DAYS=14

# Cron intervals
AVAILABILITY_CHECK_INTERVAL_DAYS=21
